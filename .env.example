# ---------------------------------------------------------------------------
# Medcare — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL in production) -----------------------------------
DATABASE_URL="postgresql://medcare:medcare@localhost:5432/medcare?schema=public"

# --- Session / crypto ------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in seconds (default 8h). Shorter is safer for shared devices.
SESSION_MAX_AGE="28800"

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Medcare"
NEXT_PUBLIC_SUPPORT_PHONE="+91-00000-00000"
NEXT_PUBLIC_SUPPORT_EMAIL="care@example.com"

# --- Feature flags ---------------------------------------------------------
# When false, OTP codes are written to the server log instead of being sent.
SMS_ENABLED="false"
WHATSAPP_ENABLED="false"
EMAIL_ENABLED="false"

# --- Notification providers (leave blank until contracted) -----------------
# Transactional email (e.g. Amazon SES, Postmark, Resend)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""

# SMS / OTP (e.g. MSG91, Twilio, Kaleyra)
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# --- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_PAYMENTS_ENABLED="false"

# --- Document storage ------------------------------------------------------
# "local" writes to ./private-uploads (development only, not web-served).
# "s3" requires the values below and a private bucket.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
